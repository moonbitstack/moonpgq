name = "moonbitstack/moonpgq"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpgq"

license = "Apache-2.0"

keywords = [
  "graph",
  "property-graph",
  "gremlin",
  "tinkerpop",
  "cypher",
  "opencypher",
  "gql",
  "iso-39075",
  "traversal",
  "query",
  "query-language",
  "parser",
  "executor",
  "graph-database",
  "database",
]

description = "Property-graph query languages: Gremlin traversal and openCypher read queries over any graph that implements the store contract."

source = "src"

import {
  "moonbitstack/moongraph@0.2.1",
}
