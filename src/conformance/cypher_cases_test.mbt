        ["[[(:C), (:D), (:E)], [(:D), (:E), (:F)]]", "2"],
        ["[[(:C), (:D), (:E), (:F)]]", "3"],
      ],
      in_order: true,
      expectation: Table,
    },
    {
      file: "return-orderby/ReturnOrderBy2.feature",
      scenario: "[13] Fail when sorting on variable removed by DISTINCT",
      setup: [
        "CREATE ({name: 'A', age: 13}), ({name: 'B', age: 12}), ({name: 'C', age: 11})",
      ],
      query: "MATCH (a)\nRETURN DISTINCT a.name\nORDER BY a.age",
      columns: [],
      rows: [],
      in_order: false,
      expectation: Raises,
    },
    {
      file: "return-orderby/ReturnOrderBy2.feature",
      scenario: "[14] Fail on aggregation in ORDER BY after RETURN",
      setup: [],
      query: "MATCH (n)\nRETURN n.num1\nORDER BY max(n.num2)",
      columns: [],
      rows: [],
      in_order: false,
      expectation: Raises,
    },
    {
      file: "return-orderby/ReturnOrderBy3.feature",
      scenario: "[1] Sort on aggregate function and normal property",
      setup: [
        "CREATE ({division: 'Sweden'})\nCREATE ({division: 'Germany'})\nCREATE ({division: 'England'})\nCREATE ({division: 'Sweden'})",
      ],
      query: "MATCH (n)\nRETURN n.division, count(*)\nORDER BY count(*) DESC, n.division ASC",
      columns: ["n.division", "count(*)"],
      rows: [["'Sweden'", "2"], ["'England'", "1"], ["'Germany'", "1"]],
      in_order: true,
      expectation: Table,
    },
    {
      file: "return-skip-limit/ReturnSkipLimit1.feature",
      scenario: "[1] Start the result from the second row",
      setup: [
        "CREATE ({name: 'A'}),\n({name: 'B'}),\n({name: 'C'}),\n({name: 'D'}),\n({name: 'E'})",
      ],
      query: "MATCH (n)\nRETURN n\nORDER BY n.name ASC\nSKIP 2",
      columns: ["n"],
      rows: [["({name: 'C'})"], ["({name: 'D'})"], ["({name: 'E'})"]],
      in_order: true,
      expectation: Table,
    },
    {
      file: "return-skip-limit/ReturnSkipLimit1.feature",
      scenario: "[2] Start the result from the second row by param",
      setup: [
        "CREATE ({name: 'A'}),\n({name: 'B'}),\n({name: 'C'}),\n({name: 'D'}),\n({name: 'E'})",
      ],
      query: "MATCH (n)\nRETURN n\nORDER BY n.name ASC\nSKIP $skipAmount",
      columns: ["n"],
      rows: [["({name: 'C'})"], ["({name: 'D'})"], ["({name: 'E'})"]],
      in_order: true,
      expectation: Unsupported("the scenario passes parameters"),
    },
    {
      file: "return-skip-limit/ReturnSkipLimit1.feature",
      scenario: "[3] SKIP with an expression that does not depend on variables",
      setup: ["UNWIND range(1, 10) AS i\nCREATE ({nr: i})"],
      query: "MATCH (n)\nWITH n SKIP toInteger(rand()*9)\nWITH count(*) AS count\nRETURN count > 0 AS nonEmpty",
      columns: ["nonEmpty"],
      rows: [["true"]],
      in_order: false,
      expectation: Table,
    },
  ]
}

