///|
fn all_cypher_cases() -> Array[CypherCase] {
  let cases : Array[CypherCase] = []
  cases.append(cypher_cases_00())
  cases.append(cypher_cases_01())
  cases.append(cypher_cases_02())
  cases.append(cypher_cases_03())
  cases
}
